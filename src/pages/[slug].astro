---
import {
    getCollection,
    render,
} from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import TextReveal from "@/components/ui/TextReveal";
import ArticleAnimate from "@/components/ui/ArticleAnimate";
import FadeContent from "@/components/ui/FadeContent";
import MDXImage from "@/components/blog/MDXImage.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
    const pages = await getCollection("pages");
    const fs = await import('node:fs/promises');
    const path = await import('node:path');

    return await Promise.all(pages.map(async (page: CollectionEntry<"pages">) => {
        let extension = '.md';
        try {
            await fs.access(path.join(process.cwd(), 'src/content/pages', page.id + '.mdx'));
            extension = '.mdx';
        } catch (e) {}

        return {
            params: {
                slug: page.id,
            },
            props: {
                entry: page,
                extension,
            },
        };
    }));
}

const {
    entry,
    extension,
} = Astro.props;

const {
    Content,
} =
    await render(
        entry,
    );
---

<Layout
    title={`${entry.data.title} // ${SITE_CONFIG.title}`}
    description={entry.data.description || `${entry.data.title} - ${SITE_CONFIG.title}`}
    rawContentUrl={`/raw/pages/${entry.id}${extension}`}
>
    <article class="max-w-3xl mx-auto pt-4 md:pt-6" data-pagefind-body>
        <header class="mb-12 text-left">
            <TextReveal
                client:load
                text={entry.data.title}
                type="char"
                className="text-2xl md:text-4xl font-bold tracking-tight leading-tight mb-8"
            />

            {entry.data.description && (
                <FadeContent
                    client:load
                    delay={
                        200
                    }
                    duration={
                        700
                    }
                    blur={
                        true
                    }
                >
                    <p class="text-lg md:text-xl text-primary-text text-left leading-[1.75] md:leading-[1.7]">
                        {
                            entry
                                .data
                                .description
                        }
                    </p>
                </FadeContent>
            )}
            <!-- Blok File PDF dengan Ikon (muncul khusus artikel ini) -->
  {(   
    <div class="mt-5 mb-7 text-left">
      <a
        href="/makalah.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-4 py-2.5 rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 transition text-sm"
      >
        <!-- Simbol / Ikon PDF -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5 text-red-400 shrink-0"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <path d="M9 15h6" />
          <path d="M9 12h6" />
        </svg>

        <span class="font-medium">Dokumen Kerukunan Antarumat Beragama (PDF)</span>
        <span class="text-xs uppercase tracking-wider px-1.5 py-0.5 rounded bg-red-500/20 text-red-300">
          PDF
        </span>
      </a>
    </div>
  )}
        </header>

        <ArticleAnimate
            client:load
            className="prose dark:prose-invert max-w-none prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight prose-a:text-black dark:prose-a:text-white prose-a:underline prose-a:decoration-1 prose-a:underline-offset-4"
        >
            <Content components={{ img: MDXImage }} />
        </ArticleAnimate>
    </article>
</Layout>
